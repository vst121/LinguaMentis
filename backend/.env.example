# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5438/linguamentis

# --- OpenRouter (server-side only, never exposed to the frontend) ---------
OPENROUTER_API_KEY=your-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=LinguaMentis

# --- Model configuration ----------------------------------------------------
# Every AI capability is independently configurable so that models/prompts
# can be swapped or A/B tested without touching application code.
AI_MODEL_BLUE=openai/gpt-4o-mini
AI_MODEL_HAT=openai/gpt-4o-mini
AI_MODEL_THINKING_EVALUATOR=openai/gpt-4o
AI_MODEL_GERMAN_EVALUATOR=openai/gpt-4o
AI_MODEL_REFLECTION=openai/gpt-4o-mini

# Generation controls
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# --- App ---------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# V1 has no authentication. A single predefined user id is used everywhere.
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
