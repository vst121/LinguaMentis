# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://linguamentis:linguamentis@localhost:5438/linguamentis

# --- Gemini (server-side only, never exposed to the frontend) -------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Model configuration ----------------------------------------------------
# Every AI capability is independently configurable so that models/prompts
# can be swapped or A/B tested without touching application code.
AI_MODEL_BLUE=gemini-2.5-flash
AI_MODEL_HAT=gemini-2.5-flash
AI_MODEL_THINKING_EVALUATOR=gemini-2.5-flash
AI_MODEL_GERMAN_EVALUATOR=gemini-2.5-flash
AI_MODEL_REFLECTION=gemini-2.5-flash
AI_MODEL_STRUCTURED_FALLBACK=gemini-2.5-flash

# Generation controls
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2

# --- Jev decision layer (optional) ----------------------------------------
# Jev is optional and disabled by default; configure a separate compatible API key if enabling.
JEV_ENABLED=false
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=10
JEV_AUTO_ACCEPT_CONFIDENCE=0.90
JEV_REVIEW_CONFIDENCE=0.70

# --- App ---------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# V1 has no authentication. A single predefined user id is used everywhere.
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
